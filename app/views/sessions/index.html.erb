<!-- app/views/sessions/index.html.erb -->
<div class="history-page">

  <!-- BACK -->
  <%= link_to root_path, class: "back-link" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    VOLTAR
  <% end %>

  <!-- HEADER -->
  <div class="history-header">
    <h1>Histórico de Recomendações</h1>
    <p>Sua linha do tempo com cada recomendação feita sob medida.</p>
  </div>

  <!-- SESSIONS LIST -->
  <div class="history-list">
    <% if @sessions.any? %>

      <!-- PRIMEIRAS 3 SESSÕES -->
      <% @visible_sessions.each do |session| %>
        <% next unless session.completed? %>
        <div class="history-entry">
          <div class="history-left">
            <div class="history-date">
              <%= session.created_at.in_time_zone('Brasilia').strftime("%d %b %Y às %H:%M") %>
            </div>
            <div class="history-inputs">
              <%= session.input_movies_list.map(&:title).join(", ") %>
            </div>
          </div>

          <div class="history-cards">
            <% recommendations = session.recommendations %>
            <% recommendations.first(3).each do |rec| %>
              <% poster = rec.dig("tmdb", "poster_url") %>
              <% match_score = rec["match_score"] || rec["score"] %>

              <% tmdb_id = rec.dig("tmdb", "tmdb_id") %>
                <%= link_to session_movie_path(session, tmdb_id), class: "history-movie-card" do %>
                <div class="history-poster">
                  <% if poster %>
                    <%= image_tag poster, alt: rec["title"] %>
                  <% else %>
                    <div class="history-poster-placeholder">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    </div>
                  <% end %>
                </div>

                <div class="history-movie-info">
                  <% if match_score %>
                    <span class="history-match-badge"><%= match_score %>% MATCH</span>
                  <% end %>
                  <h3 class="history-movie-title"><%= rec["title"] %></h3>
                  <p class="history-movie-meta">
                    <%= rec["genres"]&.first&.upcase %>
                    <% if rec["year"] %>
                      / <%= rec["year"] %>
                    <% end %>
                  </p>
                </div>
              <% end %>
            <% end %>

            <% (3 - recommendations.first(3).size).times do %>
              <div class="history-movie-card history-movie-card--empty"></div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- SESSÕES EXTRA (escondidas) -->
      <% if @hidden_sessions.any? %>

        <!-- BOTÃO CARREGAR MAIS -->
        <div id="load-more-btn" class="history-load-more">
          <button class="btn-load-more" onclick="
            document.getElementById('hidden-sessions').style.display = 'block';
            document.getElementById('load-more-btn').style.display = 'none';
          ">
            CARREGAR MAIS SESSÕES
          </button>
        </div>

        <div id="hidden-sessions" style="display: none;">
          <% @hidden_sessions.each do |session| %>
            <% next unless session.completed? %>

            <div class="history-entry">
              <div class="history-date">
                <%= session.created_at.in_time_zone('Brasilia').strftime("%d %b %Y às %H:%M") %>
              </div>

              <div class="history-cards">
                <% recommendations = session.recommendations %>
                <% recommendations.first(3).each do |rec| %>
                  <% poster = rec.dig("tmdb", "poster_url") %>
                  <% match_score = rec["match_score"] || rec["score"] %>

                  <% tmdb_id = rec.dig("tmdb", "tmdb_id") %>
                    <%= link_to session_movie_path(session, tmdb_id), class: "history-movie-card" do %>
                    <div class="history-poster">
                      <% if poster %>
                        <%= image_tag poster, alt: rec["title"] %>
                      <% else %>
                        <div class="history-poster-placeholder">
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        </div>
                      <% end %>
                    </div>

                    <div class="history-movie-info">
                      <% if match_score %>
                        <span class="history-match-badge"><%= match_score %>% MATCH</span>
                      <% end %>
                      <h3 class="history-movie-title"><%= rec["title"] %></h3>
                      <p class="history-movie-meta">
                        <%= rec["genres"]&.first&.upcase %>
                        <% if rec["year"] %>
                          / <%= rec["year"] %>
                        <% end %>
                      </p>
                    </div>
                  <% end %>
                <% end %>

                <% (3 - recommendations.first(3).size).times do %>
                  <div class="history-movie-card history-movie-card--empty"></div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- BOTÃO MOSTRAR MENOS -->
          <div class="history-load-more">
            <button class="btn-load-more" onclick="
              document.getElementById('hidden-sessions').style.display = 'none';
              document.getElementById('load-more-btn').style.display = 'flex';
              window.scrollBy({top: -400, behavior: 'smooth'});
            ">
              MOSTRAR MENOS
            </button>
          </div>
        </div>

      <% end %>

    <% else %>
      <!-- EMPTY STATE -->
      <div class="history-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <h3>Ainda sem sessões</h3>
        <p>Começa por descobrir filmes e o teu histórico aparecerá aqui.</p>
        <%= link_to "Descobrir filmes", root_path, class: "btn-discover" %>
      </div>
    <% end %>
  </div>

</div>
