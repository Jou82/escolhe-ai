<nav class="site-navbar" data-controller="navbar">
  <div class="site-navbar-container">
    <a href="/" class="navbar-brand">
      <svg class="navbar-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
      Escolhe AI
    </a>

    <div class="navbar-right">
      <% if user_signed_in? %>
        <%= link_to sessions_path, class: "navbar-link" do %>
          MEUS HISTÓRICOS
        <% end %>

        <div class="user-menu" data-controller="dropdown">
          <button class="user-menu-toggle" data-action="click->dropdown#toggle">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M20 21a8 8 0 1 0-16 0"></path></svg>
          </button>

          <div class="user-menu-panel" data-dropdown-target="menu">
            <%= link_to profile_path, class: "user-menu-item" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M20 21a8 8 0 1 0-16 0"></path></svg>
              Perfil
            <% end %>

            <%= link_to sessions_path, class: "user-menu-item" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              Meu Histórico
            <% end %>

            <div class="user-menu-divider"></div>

            <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "user-menu-item user-menu-logout" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              Logout
            <% end %>
          </div>
        </div>
      <% else %>
        <button class="btn-enter" data-action="click->login-modal#open">Entrar</button>
      <% end %>
    </div>
  </div>
</nav>
