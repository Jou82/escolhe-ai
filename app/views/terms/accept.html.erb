<div class="legal-page">
  <div class="legal-page__content" style="max-width: 600px; margin: 0 auto; padding: 2rem 1rem;">

    <header class="legal-page__header" style="text-align: center; margin-bottom: 2rem;">
      <h1 class="legal-page__title">Aceitar Termos de Uso</h1>
      <p class="legal-page__updated">Antes de continuar, confirme que você aceita nossa Política de Privacidade e Termos de Uso.</p>
    </header>

    <% if flash[:alert] %>
      <div style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; border-radius: 0.375rem; padding: 1rem; margin-bottom: 1.5rem; color: #dc3545;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: accept_terms_path, method: :patch, local: true do |f| %>
      <div class="legal-page__section" style="margin-bottom: 2rem;">
        <p style="line-height: 1.6; margin-bottom: 1.5rem;">
          Para usar o EscolheAi, você precisa aceitar nossa
          <%= link_to "Política de Privacidade", privacy_policy_path, target: "_blank", rel: "noopener" %>
          e os
          <%= link_to "Termos de Uso", terms_of_use_path, target: "_blank", rel: "noopener" %>.
        </p>

        <div class="form-check" style="margin-bottom: 2rem;">
          <%= f.check_box :accept_terms, { class: "form-check-input", id: "accept_terms_consent", style: "width: 1.25rem; height: 1.25rem; cursor: pointer;" }, "1", "0" %>
          <label class="form-check-label" for="accept_terms_consent" style="cursor: pointer; margin-left: 0.5rem;">
            Confirmo que li e aceito a Política de Privacidade e os Termos de Uso
          </label>
        </div>
      </div>

      <%= f.submit "Continuar", class: "login-submit-btn", style: "width: 100%;" %>
    <% end %>

  </div>
</div>
