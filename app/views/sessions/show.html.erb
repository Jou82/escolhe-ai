<!-- HEADER WITH BACK -->
<div class="results-top">
  <%= link_to root_path, class: "back-link" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    VOLTAR
  <% end %>

  <%= link_to root_path, class: "btn-retry" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
    Tente outra vez
  <% end %>

  <div class="results-header-text">
    <h1>Recomendações para você</h1>
    <p class="results-based">Baseado nos seus interesses '<span class="results-highlight">The Matrix</span>, ....'</p>
  </div>
</div>

<!-- MOVIE CARDS -->
<div class="results-grid">
  <div class="movie-card">
    <div class="movie-poster">
      <%= image_tag "https://image.tmdb.org/t/p/w500/1XS1oqL89opfnbLl8WnZY1O1uJx.jpg", alt: "Game of Thrones" %>
    </div>
    <div class="movie-info">
      <div class="movie-title-row">
        <h3>Game of Thrones</h3>
        <span class="movie-rating">★ 8.8</span>
      </div>
      <p class="movie-meta">2010 • Sci-Fi / Action</p>
    </div>
    <div class="movie-action">
      <%= link_to "Ver detalhes", "", class: "btn-details" %>
    </div>
  </div>

  <div class="movie-card">
    <div class="movie-poster">
      <%= image_tag "https://image.tmdb.org/t/p/w500/z2yahl2uefxDCl0nogcRBstwruJ.jpg", alt: "A Casa dos Dragões" %>
    </div>
    <div class="movie-info">
      <div class="movie-title-row">
        <h3>A Casa dos Dragões</h3>
        <span class="movie-rating">★ 8.8</span>
      </div>
      <p class="movie-meta">2017 • Sci-Fi / Drama</p>
    </div>
    <div class="movie-action">
      <%= link_to "Ver detalhes", "", class: "btn-details" %>
    </div>
  </div>

  <div class="movie-card">
    <div class="movie-poster">
      <%= image_tag "https://www.themoviedb.org/t/p/w1280/rDFy1fUU6OC3Mm0CLFB7u0fGwVN.jpg", alt: "Vikings Valhalla" %>
    </div>
    <div class="movie-info">
