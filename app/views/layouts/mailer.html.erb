<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Estilos inline para garantir compatibilidade com Gmail/Outlook */
      body {
        background-color: #0f172a;
        margin: 0;
        padding: 0;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .wrapper {
        background-color: #0f172a;
        padding: 40px 10px;
      }
      .logo {
        color: #f1f5f9;
        font-size: 20px;
        font-weight: bold;
        letter-spacing: -0.5px;
        margin-bottom: 24px;
        text-align: center;
      }
      .logo span {
        color: #38bdf8;
      }
      .email-container {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 16px;
        margin: 0 auto;
        padding: 40px 32px;
        max-width: 500px;
        color: #f1f5f9;
        text-align: center;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
      }
      .footer {
        margin-top: 32px;
        text-align: center;
        color: #64748b;
        font-size: 12px;
      }
      /* Ajuste para o conteúdo do yield */
      h1, h2 { color: #f1f5f9; margin-top: 0; }
      p { line-height: 1.6; color: #cbd5e1; }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="logo">
        Escolhe<span>aí</span>
      </div>

      <div class="email-container">
        <%= yield %>
      </div>

      <div class="footer">
        Enviado com ❤️ pela equipe do Escolhe aí.<br>
        São Paulo, Brasil.
      </div>
    </div>
  </body>
</html>
