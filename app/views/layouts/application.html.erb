<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <!-- Título Otimizado SEO -->
    <title><%= content_for(:title) || "Escolhe Aí | Ferramenta Inteligente para Tomar Decisões - Compare e Escolha" %></title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Escolhe Aí">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <meta name="user-signed-in" content="<%= user_signed_in? %>">
    <%= csp_meta_tag %>

    <!-- Meta Description Otimizada -->
    <meta name="description" content="Escolhe Aí - ferramenta inteligente para tomar decisões. Compare opções lado a lado, analise critérios personalizados e descubra a melhor escolha. Busca otimizada com 3 consultas/dia. Experimente grátis!">

    <meta name="robots" content="index, follow">

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="A8qAsRzWZdAerC0km2xpAGPIqVVluxOr1_spVz8uqkI" />

    <!-- Open Graph (Facebook, LinkedIn, WhatsApp) -->
    <meta property="og:title" content="<%= content_for?(:og_title) ? yield(:og_title) : "Escolhe Aí | Ferramenta Inteligente para Tomar Decisões" %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? yield(:og_description) : "Ferramenta gratuita que ajuda você a comparar opções e tomar decisões mais inteligentes. Análise personalizada e resultados confiáveis." %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.url %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : "https://#{request.host}/og-image.jpg" %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:twitter_title) ? yield(:twitter_title) : "Escolhe Aí | Compare e Escolha a Melhor Opção" %>">
    <meta name="twitter:description" content="<%= content_for?(:twitter_description) ? yield(:twitter_description) : "Descubra a melhor escolha com nossa ferramenta inteligente. Comparação precisa e resultados confiáveis." %>">
    <meta name="twitter:image" content="<%= content_for?(:twitter_image) ? yield(:twitter_image) : "https://#{request.host}/twitter-image.jpg" %>">

    <!-- Canonical URL -->
    <link rel="canonical" href="<%= request.url %>">

    <%= yield :head %>

    <!-- Favicon e ícones para todos os dispositivos -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <!-- CSS crítico inline (melhora LCP e FCP) -->
    <style>
      <%= File.read(Rails.root.join('app/assets/stylesheets/critical.css')).html_safe %>
    </style>

    <!-- Pré-conexão para melhorar performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://api.themoviedb.org">
    <link rel="preconnect" href="https://image.tmdb.org">

    <!-- Pré-carregar fontes críticas -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" as="style">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" as="style">

    <!-- Carregar as fontes -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags, defer: true %>
  </head>

  <body data-controller="login-modal">
    <%= render "shared/navbar" %>
    <%= render "shared/login_modal" unless user_signed_in? %>
    <%= render "shared/flashes" %>

    <main class="main-content">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
