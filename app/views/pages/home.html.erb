<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-content">
    <span class="hero-badge">PARE DE PERDER TEMPO ESCOLHENDO O QUE QUER ASSISTIR</span>
    <h1>Encontre seu próximo<span class="highlight">filme favorito</span></h1>
    <p class="hero-subtitle">Digite um filme que você ama e descubra recomendações personalizadas instantaneamente</p>

    <form action="/movies" method="post" class="search-box" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" name="movies" class="search-input" placeholder="Digite 3 filmes separados por vírgula (ex: Clube da Luta, A Origem, Batman Begins)">
      <button type="submit" class="btn-suggest">Descobrir Filmes</button>
    </form>

    <div class="trending">
      <span class="trending-label">Trending:</span>
      <a href="#" class="trending-tag">Inception</a> <%# herb:disable html-anchor-require-href %>
      <a href="#" class="trending-tag">The Bear</a> <%# herb:disable html-anchor-require-href %>
      <a href="#" class="trending-tag">Past Lives</a> <%# herb:disable html-anchor-require-href %>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="how-it-works" id="how">
  <div class="section-header">
    <h2>Como funciona</h2>
    <p>How our algorithm finds the perfect match for your movie night.</p>
  </div>

  <div class="steps-grid">
    <div class="step-card">
      <div class="step-icon-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </div>
      <h3>Digite o filme</h3>
      <p>Insira o nome de 3 filmes que você adora.</p>
    </div>

    <div class="step-card">
      <div class="step-icon-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
      </div>
      <h3>Análise inteligente</h3>
      <p>Nosso algoritmo encontra padrões de gênero, estilo e tema.</p>
    </div>

    <div class="step-card">
      <div class="step-icon-box">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
      </div>
      <h3>Receba recomendações</h3>
      <p>Descubra 3 filmes selecionados especialmente para você.</p>
    </div>
  </div>
</section>

<!-- MOVIE SHOWCASE (background section) -->
<section class="showcase">
  <div class="showcase-overlay"></div>
</section>
