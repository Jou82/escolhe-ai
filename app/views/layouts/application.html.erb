<!DOCTYPE html>
<html>
  <head>
    <%= render 'layouts/gtm_head' %>
    <title><%= content_for(:title) || "Escolhe Ai" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Escolhe Ai">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <meta name="user-signed-in" content="<%= user_signed_in? %>">
    <%= csp_meta_tag %>


   <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="login-modal">
    <%= render "shared/navbar" %>
    <%= render "shared/login_modal" unless user_signed_in? %>
    <%= render "shared/flashes" %>
    <%= render 'layouts/gtm_body' %>
    <main class="main-content">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
