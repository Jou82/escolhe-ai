<h2>Log in</h2>

<%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="form-inputs">
    <%= f.input :email,
                required: false,
                autofocus: true,
                input_html: { autocomplete: "email" } %>
    <%= f.input :password,
                required: false,
                input_html: { autocomplete: "current-password" } %>
    <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>
  </div>

  <div class="form-actions mb-3">
    <%= f.button :submit, "Log in", class: "btn btn-primary w-100" %>
  </div>
<% end %>

<div class="text-center my-3">
  <p class="text-muted small">ou</p>

  <%= button_to user_google_oauth2_omniauth_authorize_path,
      method: :post,
      data: { turbo: false },
      class: "btn btn-outline-dark w-100 d-flex align-items-center justify-center gap-2" do %>
    <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" style="width: 18px;">
    Entrar com Google
  <% end %>
</div>

<hr>

<%= render "devise/shared/links" %>
