<%# app/views/movies/processing.html.erb %>
<div style="min-height: 100vh; background: linear-gradient(to bottom, #0f172a, #1e293b); display: flex; align-items: center; justify-content: center;">
  <div class="text-center px-4">
    <!-- Badge no topo -->
    <div class="mb-8">
      <span class="inline-block px-4 py-2 rounded-full text-xs font-medium uppercase tracking-wider"
            style="background-color: rgba(59, 130, 246, 0.1); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.2);">
        Processando suas preferências
      </span>
    </div>

    <!-- Spinner animado com círculo de progresso -->
    <div class="mb-8 flex justify-center">
      <div class="relative">
        <!-- Círculo de fundo -->
        <svg class="w-40 h-40 transform -rotate-90" viewBox="0 0 120 120">
          <circle
            cx="60"
            cy="60"
            r="54"
            stroke="rgba(100, 116, 139, 0.2)"
            stroke-width="6"
            fill="none"
          />
          <!-- Círculo de progresso -->
          <circle
            id="progress-circle"
            cx="60"
            cy="60"
            r="54"
            stroke="#3b82f6"
            stroke-width="6"
            fill="none"
            stroke-dasharray="339.292"
            stroke-dashoffset="339.292"
            stroke-linecap="round"
            style="transition: stroke-dashoffset 0.5s ease; filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.5));"
          />
        </svg>

        <!-- Porcentagem no centro do círculo -->
        <div class="absolute inset-0 flex items-center justify-center">
          <span id="progress-text" class="text-4xl font-bold" style="color: #ffffff;">0%</span>
        </div>
      </div>
    </div>

    <!-- Título principal -->
    <h1 class="text-4xl md:text-5xl font-bold mb-4" style="color: #ffffff;">
      Descobrindo seus
      <span style="color: #3b82f6;">próximos filmes</span>
    </h1>

    <!-- Mensagem de status -->
    <p id="status-message" class="text-lg mb-12" style="color: #94a3b8;">
      Processando suas recomendações...
    </p>

    <!-- Link para voltar -->
    <div class="mt-8">
      <a href="/" class="text-sm hover:underline" style="color: #64748b; transition: color 0.2s;">
        ← Voltar para o início
      </a>
    </div>
  </div>
</div>

<%= turbo_stream_from "user_#{current_user.id}_recommendations" %>

<script>
  const sessionId = "<%= params[:id] %>";
  let stepIndex = 0;
  let completed = false;
  let progressInterval = null;

  const steps = [
    { progress: 10, message: "Buscando filmes similares..." },
    { progress: 25, message: "Analisando seus gostos..." },
    { progress: 40, message: "Consultando IA..." },
    { progress: 60, message: "Selecionando recomendações..." },
    { progress: 80, message: "Salvando resultados..." },
    { progress: 95, message: "Finalizando..." }
  ];

  const progressText = document.getElementById('progress-text');
  const statusMessage = document.getElementById('status-message');
  const progressCircle = document.getElementById('progress-circle');
  const circumference = 339.292; // 2 * PI * 54

  function updateProgressCircle(percent) {
    const offset = circumference - (percent / 100) * circumference;
    progressCircle.style.strokeDashoffset = offset;
  }

  function updateProgress() {
    if (completed) return;

    if (stepIndex < steps.length) {
      const step = steps[stepIndex];
      progressText.textContent = step.progress + '%';
      statusMessage.textContent = step.message;
      updateProgressCircle(step.progress);
      stepIndex++;

      const delay = Math.random() * 2000 + 2000;
      progressInterval = setTimeout(updateProgress, delay);
    }
  }

  function completeProgress() {
    if (progressInterval) {
      clearTimeout(progressInterval);
    }
    completed = true;
    progressText.textContent = '100%';
    statusMessage.textContent = 'Pronto! Redirecionando...';
    updateProgressCircle(100);
  }

  function checkAndRedirect() {
    fetch(`/movies/check_status?id=${sessionId}`)
      .then(response => response.json())
      .then(data => {
        if (data.status === "completed") {
          completeProgress();
          setTimeout(() => {
            window.location.href = `/sessions/${sessionId}`;
          }, 500);
        } else {
          setTimeout(checkAndRedirect, 2000);
        }
      })
      .catch(error => {
        console.error('Erro ao verificar status:', error);
        setTimeout(checkAndRedirect, 3000);
      });
  }

  // Inicializa com 0%
  updateProgressCircle(0);

  setTimeout(updateProgress, 1000);
  setTimeout(checkAndRedirect, 2000);
</script>
