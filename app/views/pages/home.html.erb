<%# TÍTULOS SEO OTIMIZADOS PARA RECOMENDAÇÃO DE FILMES %>
<% content_for :title, "Escolhe Aí | Descubra Seu Próximo Filme com Recomendação Inteligente" %>
<% content_for :meta_description, "Escolhe Aí: diga 3 filmes que você ama e nossa inteligência recomenda 3 filmes perfeitos para você. Curadoria personalizada baseada no seu gosto. Teste grátis!" %>
<% content_for :og_title, "Escolhe Aí - Encontre Seu Próximo Filme em 3 Cliques" %>
<% content_for :og_description, "Cite 3 produções que te marcaram. Nosso algoritmo entrega 3 filmes imperdíveis na hora.

<div data-controller="home">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="grid-overlay"></div>
    </div>

    <div class="hero-content">

      <h1 class="hero-title fade-in">
        Chega de dúvida.
        <br>
        <em>O filme certo começa aqui.</em>
      </h1>

      <p class="hero-sub fade-in">
        Cite 3 produções que te marcaram. Nosso algoritmo entrega 3 filmes imperdíveis na hora
      </p>

      <div class="search-wrapper fade-in" data-controller="autocomplete">
        <div class="search-glow"></div>
        <%= form_with url: movies_path, method: :post, class: "search-box", data: { turbo: false } do %>
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <%= text_field_tag :movies, nil, class: "search-input", placeholder: "Digite 3 filmes separados por virgula", autocomplete: "off", data: {autocomplete_target: "input", action: "input->autocomplete#search"}%>
          <ul class="autocomplete-list" data-autocomplete-target="results"></ul>
          <button type="submit" class="btn-suggest">
            Descobrir
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        <% end %>
      </div>

      <div class="trending fade-in" data-home-target="chips">
        <span class="trending-label">Tendências:</span>
        <% @popular_movies.each do |movie| %>
          <span class="trending-link" data-action="click->home#insertChip" data-genre="<%= movie %>"><%= movie %></span>
        <% end %>
      </div>

      <div class="cards-float fade-in">
        <div class="poster">
          <div class="poster-inner">
            <svg class="poster-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <div class="poster-shimmer"></div>
        </div>

        <div class="poster">
          <div class="poster-inner">
            <svg class="poster-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/>
              <path d="m14 7 3 3"/>
              <path d="M5 6v4"/>
              <path d="M19 14v4"/>
              <path d="M10 2v2"/>
              <path d="M7 8H3"/>
              <path d="M21 16h-4"/>
              <path d="M11 3H9"/>
            </svg>
          </div>
          <div class="poster-shimmer" style="animation-delay: 0.5s;"></div>
        </div>

        <div class="poster">
          <div class="poster-inner">
            <svg class="poster-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12.296 3.464 3.02 3.956"/>
              <path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3z"/>
              <path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <path d="m6.18 5.276 3.1 3.899"/>
            </svg>
          </div>
          <div class="poster-shimmer" style="animation-delay: 1s;"></div>
        </div>

    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section-how" id="how">
    <div class="section-line"></div>
    <div class="sec-label fade-in">Como funciona</div>
    <div class="sec-title fade-in">Conectamos suas referências à sua próxima história.</div>

    <div class="timeline-centered">
      <div class="tlc-item fade-in">
        <div class="tlc-dot tlc-dot-1">1</div>
        <h3>Compartilhe seu gosto</h3>
        <p>Indique 3 produções que marcaram você — valem filmes, séries ou novelas de qualquer época.</p>
        <div class="tlc-connector"></div>
      </div>
      <div class="tlc-item fade-in">
        <div class="tlc-dot tlc-dot-2">2</div>
        <h3>Analisamos a essência</h3>
        <p>O algoritmo mergulha nos temas e estéticas para identificar o que realmente importa para você.</p>
        <div class="tlc-connector"></div>
      </div>
      <div class="tlc-item fade-in">
        <div class="tlc-dot tlc-dot-3">3</div>
        <h3>Sua próxima imersão</h3>
        <p>Mergulhe em detalhes de elenco, trailers e onde encontrar cada título. Nossa curadoria cuidou de tudo: seu único papel é dar o play.</p>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="showcase-stats">
    <div class="show-card">
      <div class="show-num show-num-1">500+</div>
      <div class="show-label">Filmes recomendados</div>
    </div>
    <div class="show-card">
      <div class="show-num show-num-2">3 → 3</div>
      <div class="show-label">Simples assim</div>
    </div>
    <div class="show-card">
      <div class="show-num show-num-3">98%</div>
      <div class="show-label">Satisfação</div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-final">
    <div class="cta-glow"></div>
    <h2>Sua próxima história começa com um play.</h2>
    <p>A curadoria sob medida que a sua noite de cinema merece.</p>
    <a href="#" class="btn-cta" data-action="click->home#scrollToSearch">
      Começar agora
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </section>

</div>
