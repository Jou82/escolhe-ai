<%# app/views/session_movies/show.html.erb %>

<div class="movie-detail">

  <%# Hero backdrop %>
  <div class="movie-hero">
    <div class="movie-hero__backdrop">
      <% backdrop = @rec_data&.dig("tmdb", "poster_url")&.gsub("w500", "original") %>
      <% if backdrop %>
        <%= image_tag backdrop, alt: @movie.title %>
      <% end %>
      <div class="movie-hero__backdrop-placeholder"></div>
    </div>
    <div class="movie-hero__fade"></div>
  </div>

  <%# Back + Badge + Title %>
  <div class="movie-header container">
    <%= link_to session_path(@session_record), class: "movie-header__back" do %>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      VOLTAR
    <% end %>

    <div class="movie-header__meta">
      <% vote = @rec_data&.dig("tmdb", "vote_average") %>
      <% if vote %>
        <span class="movie-header__score">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="#F5C542"><path d="M7 1l1.8 3.6L13 5.3l-3 2.9.7 4.1L7 10.3l-3.7 2 .7-4.1-3-2.9 4.2-.7z"/></svg>
          <%= vote.round(1) %>
        </span>
      <% end %>
    </div>

    <h1 class="movie-header__title"><%= @movie.title %></h1>

    <div class="movie-header__info">
      <span><%= @movie.release_year %></span>
      <span class="dot">•</span>
      <span><%= @rec_data&.dig("genres")&.join(" • ") %></span>
    </div>


    <div class="movie-header__actions">
      <% trailer_url = @rec_data&.dig("tmdb", "trailer_url") %>
      <% streaming = @rec_data&.dig("tmdb", "streaming") || [] %>
      <% rent = @rec_data&.dig("tmdb", "rent") || [] %>
      <% buy = @rec_data&.dig("tmdb", "buy") || [] %>
      <% watch_option = streaming.first || rent.first || buy.first %>

      <% if trailer_url %>
        <%= link_to trailer_url, class: "btn-watch", target: "_blank" do %>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <circle cx="9" cy="9" r="8" stroke="white" stroke-width="1.2"/>
            <path d="M7 6l5 3-5 3V6z" fill="white"/>
          </svg>
          ASSISTIR TRAILER
        <% end %>
      <% end %>

      <% if watch_option %>
        <%= link_to watch_option["link"], class: "btn-watch btn-watch--outline", target: "_blank" do %>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="2" y="4" width="14" height="10" rx="2" stroke="white" stroke-width="1.2"/>
            <path d="M7 7l4 2-4 2V7z" fill="white"/>
          </svg>
          ONDE ASSISTIR
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Main content grid %>
  <div class="movie-content container">

    <%# Left column %>
    <div class="movie-content__left">

      <%# Why we recommend %>
      <div class="card card--why">
        <div class="card__header">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M8 2l1.5 3 3.3.5-2.4 2.3.6 3.2L8 9.5l-3 1.5.6-3.2L3.2 5.5l3.3-.5z" fill="#4F8EF7"/>
          </svg>
          <span class="card__title-blue">Por que recomendamos isso</span>
        </div>
        <div class="card__reasons">
          <div class="card__reason">
            <div class="card__reason-icon card__reason-icon--red">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 3c2.5 0 5 2 5 4.5 0 2-2 4.5-5 6-3-1.5-5-4-5-6C3 5 5.5 3 8 3z" stroke="#E05B7F" stroke-width="1.2"/>
              </svg>
            </div>
            <div>
              <p class="card__reason-title">Seu perfil</p>
              <p class="card__reason-text"><%= @session_record.analysis %></p>
            </div>
          </div>
          <div class="card__reason">
            <div class="card__reason-icon card__reason-icon--blue">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 2a6 6 0 100 12A6 6 0 008 2z" stroke="#4F8EF7" stroke-width="1.2"/>
                <path d="M5 8l2 2 4-4" stroke="#4F8EF7" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <p class="card__reason-title">Por que esse filme</p>
              <p class="card__reason-text"><%= @rec_data&.dig("reason") %></p>
            </div>
          </div>
        </div>
      </div>

      <%# Synopsis %>
      <div class="section-synopsis">
        <h2 class="section-title">Sinopse</h2>
        <p class="synopsis-text">
          <%= @rec_data&.dig("tmdb", "overview") || @movie.synopsis %>
        </p>
      </div>

      <%# Top Cast — dentro da coluna esquerda, depois da Sinopse %>
      <% cast = @rec_data&.dig("tmdb", "cast") || [] %>
      <% if cast.any? %>
        <div class="section-cast">
          <h2 class="section-title">Top Cast</h2>
          <div class="cast-grid">
            <% cast.each do |member| %>
              <div class="cast-card">
                <div class="cast-card__photo">
                  <% if member["photo_url"] %>
                    <%= image_tag member["photo_url"], alt: member["name"], class: "cast-card__img" %>
                  <% else %>
                    <div class="cast-card__placeholder">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M20 21a8 8 0 1 0-16 0"/>
                      </svg>
                    </div>
                  <% end %>
                </div>
                <p class="cast-card__name"><%= member["name"] %></p>
                <p class="cast-card__character"><%= member["character"] %></p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

    </div><%# fim movie-content__left %>

    <%# Right column %>
    <div class="movie-content__right">

      <%# Rating summary %>
      <% if vote %>
        <div class="card card--rating">
          <h3 class="card__label">Avaliação</h3>
          <div class="rating-score">
            <span class="rating-score__number"><%= vote.round(1) %></span>
            <div class="rating-score__stars">
              <svg width="72" height="14" viewBox="0 0 72 14" fill="#F5C542">
                <path d="M7 1l1.5 3 3.3.5-2.4 2.3.6 3.2L7 8.5l-3 1.5.6-3.2L2.2 4.5l3.3-.5z"/>
                <path d="M21 1l1.5 3 3.3.5-2.4 2.3.6 3.2L21 8.5l-3 1.5.6-3.2L16.2 4.5l3.3-.5z"/>
                <path d="M35 1l1.5 3 3.3.5-2.4 2.3.6 3.2L35 8.5l-3 1.5.6-3.2L30.2 4.5l3.3-.5z"/>
                <path d="M49 1l1.5 3 3.3.5-2.4 2.3.6 3.2L49 8.5l-3 1.5.6-3.2L44.2 4.5l3.3-.5z"/>
                <path d="M63 1l1.5 3 3.3.5-2.4 2.3.6 3.2L63 8.5l-3 1.5.6-3.2L58.2 4.5l3.3-.5z" fill-opacity="0.3"/>
              </svg>
            </div>
          </div>
        </div>
      <% end %>

      <%# Where to watch %>
      <div class="card card--watch">
        <h3 class="card__label">Onde assistir</h3>
        <div class="watch-list">
          <% all_streaming = @rec_data&.dig("tmdb", "streaming") || [] %>
          <% user_platforms = current_user.streaming_platforms || [] %>
          <% if user_platforms.any? %>
            <% streaming = all_streaming.select { |s| user_platforms.include?(s["name"]) } %>
          <% else %>
            <% streaming = all_streaming %>
          <% end %>
          <% rent = @rec_data&.dig("tmdb", "rent") || [] %>
          <% buy = @rec_data&.dig("tmdb", "buy") || [] %>
          <% if streaming.any? %>
            <p class="card__label">Assinatura</p>
            <% streaming.each do |s| %>
              <div class="watch-item">
                <% if s["logo_url"] %>
                  <%= image_tag s["logo_url"], class: "watch-item__logo", alt: s["name"] %>
                <% end %>
                <span><%= s["name"] %></span>
              </div>
            <% end %>
          <% end %>
          <% if rent.any? %>
            <p class="card__label">Aluguel</p>
            <% rent.each do |r| %>
              <div class="watch-item">
                <% if r["logo_url"] %>
                  <%= image_tag r["logo_url"], class: "watch-item__logo", alt: r["name"] %>
                <% end %>
                <span><%= r["name"] %></span>
              </div>
            <% end %>
          <% end %>
          <% if buy.any? %>
            <p class="card__label">Comprar</p>
            <% buy.each do |b| %>
              <div class="watch-item">
                <% if b["logo_url"] %>
                  <%= image_tag b["logo_url"], class: "watch-item__logo", alt: b["name"] %>
                <% end %>
                <span><%= b["name"] %></span>
              </div>
            <% end %>
          <% end %>
          <% if streaming.empty? && rent.empty? && buy.empty? %>
            <p>Indisponível no momento</p>
          <% end %>
        </div>
      </div>

    </div><%# fim movie-content__right %>

  </div><%# fim movie-content %>

</div><%# fim movie-detail %>
