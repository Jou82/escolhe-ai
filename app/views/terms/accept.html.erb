<div class="legal-page">

  <div class="legal-page__lang-switcher">
    <%= link_to "PT", accept_terms_path(locale: :pt), class: "legal-page__lang #{'legal-page__lang--active' if I18n.locale == :pt}" %>
    <%= link_to "EN", accept_terms_path(locale: :en), class: "legal-page__lang #{'legal-page__lang--active' if I18n.locale == :en}" %>
    <%= link_to "DE", accept_terms_path(locale: :de), class: "legal-page__lang #{'legal-page__lang--active' if I18n.locale == :de}" %>
  </div>

  <div class="legal-page__content" style="max-width: 600px; margin: 0 auto; padding: 2rem 1rem;">

    <header class="legal-page__header" style="text-align: center; margin-bottom: 2rem;">
      <h1 class="legal-page__title"><%= t('terms.accept.title') %></h1>
      <p class="legal-page__updated"><%= t('terms.accept.subtitle') %></p>
    </header>

    <% if flash[:alert] %>
      <div style="background-color: rgba(220, 53, 69, 0.1); border: 1px solid #dc3545; border-radius: 0.375rem; padding: 1rem; margin-bottom: 1.5rem; color: #dc3545;">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: accept_terms_path, method: :patch, local: true do |f| %>
      <div class="legal-page__section" style="margin-bottom: 2rem;">
        <p style="line-height: 1.6; margin-bottom: 1.5rem;">
          <%= t('terms.accept.description_html', privacy_link: link_to(t('terms.accept.privacy_label'), privacy_policy_path(locale: I18n.locale), target: "_blank", rel: "noopener"), terms_link: link_to(t('terms.accept.terms_label'), terms_of_use_path(locale: I18n.locale), target: "_blank", rel: "noopener")) %>
        </p>

        <div class="form-check" style="margin-bottom: 2rem;">
          <%= f.check_box :accept_terms, { class: "form-check-input", id: "accept_terms_consent", style: "width: 1.25rem; height: 1.25rem; cursor: pointer;" }, "1", "0" %>
          <label class="form-check-label" for="accept_terms_consent" style="cursor: pointer; margin-left: 0.5rem;">
            <%= t('terms.accept.checkbox_label') %>
          </label>
        </div>
      </div>

      <%= f.submit t('terms.accept.submit_button'), class: "login-submit-btn", style: "width: 100%;" %>
    <% end %>

  </div>
</div>
