<!-- HEADER WITH BACK -->
<div class="results-top">
  <%= link_to root_path, class: "back-link" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
    VOLTAR
  <% end %>

 <form action="/movies" method="post" data-turbo="false" style="display: inline;">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="movies" value="<%= @user_movies.map(&:title).join(', ') %>">
    <input type="hidden" name="exclude" value="<%= @suggested_movies.map(&:title).join(', ') %>">
    <button type="submit" class="btn-retry">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
      Tente outra vez
    </button>
  </form>
  <div class="results-header-text">
    <h1>Recomendações para você</h1>
    <p class="results-based">Baseado nos seus interesses '<span class="results-highlight"><%= @user_movies.map(&:title).join("', '") %></span>'</p>
  </div>
</div>

<!-- MOVIE CARDS -->
<div class="results-grid">
  <% @recommendations.each do |rec| %>
    <div class="movie-card">
      <div class="movie-poster">
        <% poster = rec.dig("tmdb", "poster_url") %>
        <% if poster %>
          <%= image_tag poster, alt: rec["title"] %>
        <% end %>
      </div>
      <div class="movie-info">
        <div class="movie-title-row">
          <h3><%= rec["title"] %></h3>
          <% vote = rec.dig("tmdb", "vote_average") %>
          <% if vote %>
            <span class="movie-rating">★ <%= vote.round(1) %></span>
          <% end %>
        </div>
        <p class="movie-meta"><%= rec["year"] %> • <%= rec["genres"]&.join(" / ") %></p>
      </div>
      <div class="movie-action">
        <% movie = @suggested_movies.find { |m| m.title == rec["title"] } %>
        <% if movie %>
          <%= link_to "Ver detalhes", session_movie_path(@session_record, movie), class: "btn-details" %>
        <% else %>
          <%= link_to "Ver detalhes", "#", class: "btn-details" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
<div class="results-space"></div>
