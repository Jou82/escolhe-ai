<%# app/views/pages/profile.html.erb %>
<%# Página de Conta & Perfil — sem sidebar nem footer %>

<% if notice %>
  <div class="flash flash--success"><%= notice %></div>
<% end %>
<% if alert %>
  <div class="flash flash--error"><%= alert %></div>
<% end %>

<div class="account-page" data-controller="profile">

  <%# ── Page Header ─────────────────────────────────────── %>
  <header class="account-page__header">
    <span class="account-page__eyebrow">Gerencie suas preferências de curadoria digital</span>
    <h1 class="account-page__title">Conta & Perfil</h1>
  </header>

  <%# ── Main Grid ───────────────────────────────────────── %>
  <div class="account-page__grid">

    <%# ── LEFT COLUMN ─────────────────────────────────── %>
    <div class="account-page__left">

      <%# Card: Profile Info (visual — sem backend por enquanto) %>
      <div class="profile-card">
        <div class="profile-card__body">

          <%# Avatar — inicial do email %>
          <div class="profile-card__avatar-wrapper" data-controller="avatar-picker">
            <div class="profile-card__avatar" data-action="click->avatar-picker#open">
              <% if current_user.avatar.present? %>
                <img src="<%= current_user.avatar_url %>" class="profile-card__avatar-img" alt="Avatar">
              <% else %>
                <span class="profile-card__initials"><%= current_user.email[0].upcase %></span>
              <% end %>
              <div class="profile-card__avatar-edit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
              </div>
            </div>

            <%# Modal %>
            <div class="avatar-modal" data-avatar-picker-target="modal">
              <div class="avatar-modal__backdrop" data-action="click->avatar-picker#close"></div>
              <div class="avatar-modal__box">
                <h3 class="avatar-modal__title">Escolha seu avatar</h3>
                <div class="avatar-modal__grid">
                  <% User::AVATARS.each do |av| %>
                    <button type="button"
                            class="avatar-option <%= 'avatar-option--active' if current_user.avatar == av %>"
                            data-action="click->avatar-picker#select"
                            data-avatar="<%= av %>">
                      <img src="https://res.cloudinary.com/dyplenk9j/image/upload/avatares_2/<%= av %>.png" alt="<%= av %>">
                    </button>
                  <% end %>
                </div>
                <div class="avatar-modal__actions">
                  <button type="button" class="btn btn--outline" data-action="click->avatar-picker#close">Cancelar</button>
                  <button type="button" class="btn btn--primary" data-action="click->avatar-picker#save">Salvar</button>
                </div>
              </div>
            </div>
          </div>

          <%# ───────────────────────────────────── %>
          <%# INFOS %>
          <div class="profile-card__fields">
            <div class="profile-card__row">
              <div class="form-group">
                <label class="form-label" for="user_display_name">Display Name</label>
                <input type="text" id="user_display_name" class="form-input" placeholder="Seu nome" value="<%= current_user.email.split('@').first.capitalize %>">
              </div>
              <div class="form-group">
                <label class="form-label" for="user_email">Email Address</label>
                <input type="email" id="user_email" class="form-input" value="<%= current_user.email %>" placeholder="seu@email.com" readonly>
              </div>
            </div>

            <div class="profile-card__actions">
              <button type="button" class="btn btn--primary">Salvar alterações</button>
            </div>
          </div>
        </div>
      </div>

      <%# Card: Streaming Services (funcional) ─────────── %>
      <div class="streaming-card" data-controller="streaming-search"
           data-streaming-search-update-url-value="<%= update_profile_path %>">
        <div class="streaming-card__header">
          <h2 class="streaming-card__title">Serviços de Streaming</h2>
          <p class="streaming-card__subtitle">Selecione as plataformas que utiliza para recomendações personalizadas.</p>
        </div>

        <div class="streaming-card__search">
          <svg class="streaming-card__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input type="text"
                 class="streaming-card__search-input"
                 placeholder="Procure serviços de streaming (Netflix, Prime, etc...)"
                 data-streaming-search-target="input"
                 data-action="input->streaming-search#filter focus->streaming-search#filter"
                 autocomplete="off">

          <%# Dropdown — gerado a partir de User::STREAMING_OPTIONS %>
          <div class="streaming-card__dropdown" data-streaming-search-target="dropdown" hidden>
            <% User::STREAMING_OPTIONS.each do |platform| %>
              <button type="button"
                      class="streaming-card__dropdown-item"
                      data-action="click->streaming-search#select"
                      data-platform="<%= platform %>">
                <%= platform %>
              </button>
            <% end %>
          </div>
        </div>

        <%# Tags já selecionadas pelo usuário %>
        <div class="streaming-card__tags" data-streaming-search-target="tags">
          <% (current_user.streaming_platforms || []).each do |platform| %>
            <span class="streaming-tag" data-platform="<%= platform %>">
              <span class="streaming-tag__name"><%= platform.upcase %></span>
              <button type="button" class="streaming-tag__remove" data-action="click->streaming-search#remove" data-platform="<%= platform %>" aria-label="Remover <%= platform %>">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── RIGHT COLUMN ────────────────────────────────── %>
    <div class="account-page__right">

      <%# Card: Segurança (visual — sem backend por enquanto) %>
      <div class="security-card">
        <%= simple_form_for current_user, url: users_path, method: :patch do |f| %>

          <div class="form-group">
            <%= f.label :current_password, "Senha Atual", class: "form-label" %>
            <%= f.password_field :current_password, class: "form-input", placeholder: "••••••••" %>
          </div>

          <div class="form-group">
            <%= f.label :password, "Nova Senha", class: "form-label" %>
            <%= f.password_field :password, class: "form-input", placeholder: "••••••••" %>
          </div>

          <div class="form-group">
            <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "form-label" %>
            <%= f.password_field :password_confirmation, class: "form-input", placeholder: "••••••••" %>
          </div>

          <%= f.submit "Atualizar senha", class: "btn btn--outline btn--full" %>

        <% end %>
      </div>

    </div>
  </div>
</div>
