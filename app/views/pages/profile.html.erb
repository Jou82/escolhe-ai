<%# app/views/pages/profile.html.erb %>
<%# Página de Conta & Perfil — sem sidebar nem footer %>
<div class="account-page" data-controller="profile">

  <%# ── Page Header ─────────────────────────────────────── %>
  <header class="account-page__header">
    <div class="account-page__header-top">
      <div>
        <span class="account-page__eyebrow"><%= t("profile.header.eyebrow") %></span>
        <h1 class="account-page__title"><%= t("profile.header.title") %></h1>
      </div>
      <%# Language Selector %>
      <div class="language-selector">
        <% %w[pt-BR en de].each do |locale| %>
          <% locale_name = {"pt-BR" => "PT", "en" => "EN", "de" => "DE"}[locale] %>
          <a href="<%= profile_path(locale: locale) %>"
             class="language-selector__link <%= 'language-selector__link--active' if I18n.locale.to_s == locale %>">
            <%= locale_name %>
          </a>
        <% end %>
      </div>
    </div>
  </header>

  <%# ── Main Grid ───────────────────────────────────────── %>
  <div class="account-page__grid">

    <%# ── LEFT COLUMN ─────────────────────────────────── %>
    <div class="account-page__left">

      <%# Card: Profile Info (visual — sem backend por enquanto) %>
      <div class="profile-card">
        <div class="profile-card__body">

          <%# Avatar — inicial do email %>
          <div class="profile-card__avatar-wrapper" data-controller="avatar-picker">
            <div class="profile-card__avatar" data-action="click->avatar-picker#open">
              <% if current_user.avatar.present? %>
                <%= cl_image_tag(current_user.avatar, width: 100, height: 100, crop: :fill, class: "profile-card__avatar-img", alt: "Avatar") %>
              <% else %>
                <span class="profile-card__initials"><%= current_user.email[0].upcase %></span>
              <% end %>
              <div class="profile-card__avatar-edit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                </svg>
              </div>
            </div>

            <%# Modal %>
            <div class="avatar-modal" data-avatar-picker-target="modal">
              <div class="avatar-modal__backdrop" data-action="click->avatar-picker#close"></div>
              <div class="avatar-modal__box">
                <h3 class="avatar-modal__title"><%= t("profile.info_card.avatar_modal_title") %></h3>
                <div class="avatar-modal__grid">
                  <% User::AVATARS.each do |av| %>
                    <button type="button"
                            class="avatar-option <%= 'avatar-option--active' if current_user.avatar == av %>"
                            data-action="click->avatar-picker#select"
                            data-avatar="<%= av %>">

                      <%# O helper cl_image_tag monta a URL completa %>
                      <%= cl_image_tag(av, width: 100, height: 100, crop: :fill, alt: "Opção de Avatar") %>
                    </button>
                  <% end %>
                </div>
                <div class="avatar-modal__actions">
                  <button type="button" class="btn btn--outline" data-action="click->avatar-picker#close"><%= t("profile.info_card.avatar_modal_cancel") %></button>
                  <button type="button" class="btn btn--primary" data-action="click->avatar-picker#save"><%= t("profile.info_card.avatar_modal_save") %></button>
                </div>
              </div>
            </div>
          </div>

          <%# ───────────────────────────────────── %>
          <%# INFOS %>
          <div class="profile-card__fields">

            <%= simple_form_for current_user, url: users_path, method: :patch, html: { data: { turbo: false } } do |f| %>
              <div class="profile-card__row">
                <div class="form-group">
                  <label class="form-label" for="user_display_name"><%= t("profile.info_card.display_name_label") %></label>
                  <%= f.text_field :display_name,
                      id: "user_display_name",
                      class: "form-input",
                      placeholder: t("profile.info_card.display_name_placeholder"),
                      data: {
                        profile_target: "nameInput",
                        action: "input->profile#checkName"
                      } %>
                </div>
                <div class="form-group">
                  <%= f.label :email, t("profile.info_card.email_label"), class: "form-label" %>
                  <%= f.email_field :email,
                      class: "form-input",
                      placeholder: t("profile.info_card.email_placeholder"),
                      data: {
                        profile_target: "emailInput",
                        action: "input->profile#checkEmail"
                      } %>
                </div>
              </div>

              <div class="profile-card__actions">
                  <button type="button"
                          class="btn btn--primary"
                          data-profile-target="saveBtn"
                          data-action="click->profile#openEmailModal">
                    <%= t("profile.info_card.save_changes") %>
                  </button>
              </div>

              <%# Modal confirmação de senha %>
              <div class="email-modal" data-profile-target="emailModal">
                <div class="email-modal__backdrop" data-action="click->profile#closeEmailModal"></div>
                <div class="email-modal__box">
                  <h3 class="email-modal__title"><%= t("profile.info_card.email_modal_title") %></h3>
                  <p class="email-modal__subtitle"><%= t("profile.info_card.email_modal_subtitle") %></p>
                  <div class="form-group">
                    <%= f.label :current_password, t("profile.info_card.current_password_label"), class: "form-label" %>
                    <%= f.password_field :current_password, class: "form-input", placeholder: "••••••••" %>
                  </div>
                  <div class="email-modal__actions">
                    <button type="button" class="btn btn--outline" data-action="click->profile#closeEmailModal"><%= t("profile.info_card.email_modal_cancel") %></button>
                    <%= f.submit t("profile.info_card.email_modal_confirm"), class: "btn btn--primary" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Card: Streaming Services (funcional) ─────────── %>
      <div class="streaming-card" data-controller="streaming-search"
           data-streaming-search-update-url-value="<%= update_profile_path %>">
        <div class="streaming-card__header">
          <h2 class="streaming-card__title"><%= t("profile.streaming_card.title") %></h2>
          <p class="streaming-card__subtitle"><%= t("profile.streaming_card.subtitle") %></p>
        </div>

        <div class="streaming-card__search">
          <svg class="streaming-card__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
          <input type="text"
                 class="streaming-card__search-input"
                 placeholder="<%= t('profile.streaming_card.search_placeholder') %>"
                 data-streaming-search-target="input"
                 data-action="input->streaming-search#filter focus->streaming-search#filter"
                 autocomplete="off">

          <%# Dropdown — gerado a partir de User::STREAMING_OPTIONS %>
          <div class="streaming-card__dropdown" data-streaming-search-target="dropdown" hidden>
            <% User::STREAMING_OPTIONS.each do |platform| %>
              <button type="button"
                      class="streaming-card__dropdown-item"
                      data-action="click->streaming-search#select"
                      data-platform="<%= platform %>">
                <%= platform %>
              </button>
            <% end %>
          </div>
        </div>

        <%# Tags já selecionadas pelo usuário %>
        <div class="streaming-card__tags" data-streaming-search-target="tags">
          <% (current_user.streaming_platforms || []).each do |platform| %>
            <span class="streaming-tag" data-platform="<%= platform %>">
              <span class="streaming-tag__name"><%= platform.upcase %></span>
              <button type="button" class="streaming-tag__remove" data-action="click->streaming-search#remove" data-platform="<%= platform %>" aria-label="Remover <%= platform %>">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── RIGHT COLUMN ────────────────────────────────── %>
    <div class="account-page__right">

      <%# Card: Segurança %>
      <div class="security-card">
        <div class="security-card__icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h2 class="security-card__title"><%= t("profile.security_card.title") %></h2>
        <p class="security-card__subtitle"><%= t("profile.security_card.subtitle") %></p>

        <div class="security-card__form">
          <%= simple_form_for current_user, url: users_path, method: :patch, html: { data: { turbo: false } } do |f| %>

            <div class="form-group">
              <%= f.label :current_password, t("profile.security_card.current_password_label"), class: "form-label" %>
              <%= f.password_field :current_password, class: "form-input", placeholder: t("profile.security_card.password_placeholder") %>
            </div>

            <div class="form-group">
              <%= f.label :password, t("profile.security_card.new_password_label"), class: "form-label" %>
              <%= f.password_field :password, class: "form-input", placeholder: t("profile.security_card.password_placeholder") %>
            </div>

            <div class="form-group">
              <%= f.label :password_confirmation, t("profile.security_card.password_confirmation_label"), class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-input", placeholder: t("profile.security_card.password_placeholder") %>
            </div>

            <%= f.submit t("profile.security_card.update_password_button"), class: "btn btn--outline btn--full" %>

          <% end %>
        </div>
      </div>

      <%# Card: Danger Zone — Delete Account %>
      <div class="danger-card">
        <div class="danger-card__icon">⚠</div>
        <div>
          <div class="danger-card__title"><%= t("profile.danger_card.title") %></div>
          <div class="danger-card__subtitle"><%= t("profile.danger_card.subtitle") %></div>
        </div>
        <button type="button"
                class="btn btn--danger"
                data-profile-target="deleteBtn"
                data-action="click->profile#openDeleteModal">
          <%= t("profile.danger_card.delete_button") %>
        </button>
      </div>

      <%# Modal: Delete Account Confirmation %>
      <div class="delete-modal" data-profile-target="deleteModal">
        <div class="delete-modal__backdrop" data-action="click->profile#closeDeleteModal"></div>
        <div class="delete-modal__box">
          <h3 class="delete-modal__title"><%= t("profile.danger_card.delete_modal_title") %></h3>
          <p class="delete-modal__subtitle"><%= t("profile.danger_card.delete_modal_subtitle") %></p>

          <%= form_with url: user_registration_path, method: :delete, local: true, style: "display: contents;" do |f| %>
            <% if current_user.provider.present? %>
              <%# OAuth user — apenas checkbox de confirmação %>
              <div class="delete-modal__checkbox">
                <label class="delete-modal__label">
                  <input type="checkbox" id="delete-confirm-checkbox" />
                  <span><%= t("profile.danger_card.delete_modal_confirmation_checkbox") %></span>
                </label>
              </div>
            <% else %>
              <%# Email/password user — pedir senha %>
              <div class="form-group">
                <label class="form-label" for="delete-password"><%= t("profile.danger_card.delete_modal_password_label") %></label>
                <input type="password"
                       id="delete-password"
                       class="form-input"
                       placeholder="<%= t('profile.danger_card.delete_modal_password_placeholder') %>"
                       autocomplete="current-password"
                       name="current_password">
              </div>
            <% end %>

            <div class="delete-modal__actions">
              <button type="button" class="btn btn--outline" data-action="click->profile#closeDeleteModal"><%= t("profile.danger_card.delete_modal_cancel") %></button>
              <%= f.submit t("profile.danger_card.delete_modal_confirm"), class: "btn btn--danger", data: { action: "click->profile#submitDelete" } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
