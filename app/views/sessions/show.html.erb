<!-- HEADER WITH BACK -->
<div class="results-top">
  <div class="results-top-left">
    <%= link_to root_path, class: "back-link" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      VOLTAR
    <% end %>
  </div>

  <div class="results-top-center">
    <form action="/movies" method="post" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="movies" value="<%= @user_movies.map(&:title).join(', ') %>">
      <input type="hidden" name="exclude" value="<%= @suggested_movies.map(&:title).join(', ') %>">
      <button type="submit" class="btn-retry">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
        Tente outra vez
      </button>
    </form>
  </div>

  <div class="results-top-right">
    <h1>Recomendações exclusivas para você</h1>
    <p class="results-based">Sincronizado com suas preferências</p>
  </div>
</div>

<!-- MOVIE CARDS -->
<div class="results-grid">
  <% @recommendations.each do |rec| %>
    <div class="movie-card">
      <div class="movie-poster">
        <% poster = rec.dig("tmdb", "poster_url") %>
        <% if poster %>
          <%= image_tag poster, alt: rec["title"] %>
        <% end %>
      </div>
      <div class="movie-info">
        <div class="movie-title-row">
          <h3><%= rec["title"] %></h3>
          <% vote = rec.dig("tmdb", "vote_average") %>
          <% if vote %>
            <span class="movie-rating">★ <%= vote.round(1) %></span>
          <% end %>
        </div>
        <p class="movie-meta"><%= rec["year"] %> • <%= rec["genres"]&.join(" / ") %></p>
      </div>
      <div class="movie-action">
        <% tmdb_id = rec.dig("tmdb", "tmdb_id") %>
        <%= link_to "Ver detalhes", movie_session_movie_path(@session_record, tmdb_id), class: "btn-details" %>
      </div>
    </div>
  <% end %>
</div>

<div style="text-align: center; margin-top: 1rem; margin-bottom: 2rem;">
  <a href="/sessions/<%= @session_record.id %>/random_movie"
     class="btn-retry"
     onclick="window.location.href=this.href; return false;">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="16 3 21 3 21 8"></polyline>
      <line x1="4" y1="20" x2="21" y2="3"></line>
      <polyline points="21 16 21 21 16 21"></polyline>
      <line x1="15" y1="15" x2="21" y2="21"></line>
      <line x1="4" y1="4" x2="9" y2="9"></line>
    </svg>
    Escolha aleatória
  </a>
</div>
