<%# app/views/movies/processing.html.erb %>
<div class="processing-page"
     data-controller="processing"
     data-processing-session-id-value="<%= params[:id] %>">
  <div class="processing-container">
    <!-- Badge no topo -->
    <div class="processing-badge-wrapper">
      <span class="processing-badge">
        Processando suas preferências
      </span>
    </div>

    <!-- Spinner animado com círculo de progresso -->
    <div class="processing-spinner-wrapper">
      <div class="processing-spinner-container">
        <!-- Círculo de fundo -->
        <svg class="processing-circle" viewBox="0 0 120 120">
          <circle
            cx="60"
            cy="60"
            r="54"
            class="progress-bg"
          />
          <!-- Círculo de progresso -->
          <circle
            data-processing-target="progressCircle"
            cx="60"
            cy="60"
            r="54"
            class="progress-fill"
          />
        </svg>

        <!-- Porcentagem no centro do círculo -->
        <div class="progress-text-wrapper">
          <span data-processing-target="progressText" class="progress-percentage">0%</span>
        </div>
      </div>
    </div>

    <!-- Título principal -->
    <h1 class="processing-title">
      Descobrindo seus
      <span class="text-highlight">próximos filmes</span>
    </h1>

    <!-- Mensagem de status -->
    <p data-processing-target="statusMessage" class="processing-status">
      Processando suas recomendações...
    </p>

    <!-- Turbo Stream target for job broadcasts (status / error / redirect) -->
    <div id="recommendations_container" class="processing-stream-target" aria-live="polite"></div>

    <!-- Link para voltar -->
    <div class="processing-back">
      <%= link_to "← Voltar para o início", root_path, class: "back-link" %>
    </div>
  </div>
</div>

<%= turbo_stream_from "user_#{current_user.id}_recommendations" %>
