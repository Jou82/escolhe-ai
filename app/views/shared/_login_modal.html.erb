<%# app/views/shared/_login_modal.html.erb %>
<div class="login-modal-overlay" data-login-modal-target="overlay">
  <div class="login-modal">
    <button class="login-modal-close" data-action="click->login-modal#close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <%# ============ PAINEL LOGIN ============ %>
    <div data-login-modal-target="panelLogin">
      <div class="login-modal-header">
        <h2>Bem-vindo</h2>
        <p>Entre para salvar suas recomendações</p>
      </div>
      <div class="login-modal-oauth">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post, data: { turbo: false }, class: "login-oauth-btn" do %>
          <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" width="18" height="18">
          Continuar com Google
        <% end %>
      </div>
      <div class="login-modal-divider"><span>OU CONTINUE COM EMAIL</span></div>
      <%= simple_form_for(User.new, as: :user, url: user_session_path, data: { turbo: false }, html: { class: "login-modal-form" }) do |f| %>
        <div class="login-field">
          <label>EMAIL</label>
          <%= f.input :email, required: false, label: false, placeholder: "nome@exemplo.com",
                      input_html: { autocomplete: "email", class: "login-input" } %>
        </div>
        <div class="login-field">
          <div class="login-field-header">
            <label>SENHA</label>
            <a href="#" class="login-forgot" data-action="click->login-modal#switchToForgot">ESQUECEU?</a>
          </div>
          <%= f.input :password, required: false, label: false, placeholder: "••••••••",
                      input_html: { autocomplete: "current-password", class: "login-input" } %>
        </div>
        <%= f.button :submit, "Entrar na conta", class: "login-submit-btn" %>
      <% end %>
      <div class="login-modal-footer">
        <p>Não tem uma conta? <a href="#" class="login-create-link" data-action="click->login-modal#switchToRegister">Criar conta</a></p>
      </div>
    </div>

    <%# ============ PAINEL REGISTO ============ %>
    <div data-login-modal-target="panelRegister" hidden>
      <div class="login-modal-header">
        <h2>Criar conta</h2>
        <p>Junte-se para guardar as suas recomendações</p>
      </div>
      <div class="login-modal-oauth">
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            method: :post, data: { turbo: false }, class: "login-oauth-btn" do %>
          <img src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png" alt="Google" width="18" height="18">
          Continuar com Google
        <% end %>
      </div>
      <div class="login-modal-divider"><span>OU CRIE COM EMAIL</span></div>
      <%= simple_form_for(User.new, as: :user, url: users_path, data: { turbo: false }, html: { class: "login-modal-form" }) do |f| %>
        <div class="login-field">
          <label>EMAIL</label>
          <%= f.input :email, required: false, label: false, placeholder: "nome@exemplo.com",
                      input_html: { autocomplete: "email", class: "login-input" } %>
        </div>
        <div class="login-field">
          <label>SENHA</label>
          <%= f.input :password, required: false, label: false, placeholder: "••••••••",
                      input_html: { autocomplete: "new-password", class: "login-input" } %>
        </div>
        <div class="login-field">
          <label>CONFIRMAR SENHA</label>
          <%= f.input :password_confirmation, required: false, label: false, placeholder: "••••••••",
                      input_html: { autocomplete: "new-password", class: "login-input" } %>
        </div>
        <div class="form-check mb-3">
          <%= check_box_tag "user[accept_terms]", "1", false,
                class: "form-check-input",
                id: "accept_terms" %>
          <label class="form-check-label small" for="accept_terms">
            Li e aceito a
            <%= link_to "Política de Privacidade", privacy_policy_path, target: "_blank", rel: "noopener" %>
            e os
            <%= link_to "Termos de Uso", terms_of_use_path, target: "_blank", rel: "noopener" %>.
          </label>
        </div>
        <%= f.button :submit, "Criar conta", class: "login-submit-btn" %>
      <% end %>
      <div class="login-modal-footer">
        <p>Já tem uma conta? <a href="#" class="login-create-link" data-action="click->login-modal#switchToLogin">Entrar</a></p>
      </div>
    </div>

    <%# ============ PAINEL ESQUECEU SENHA ============ %>
    <div data-login-modal-target="panelForgot" hidden>
      <div class="login-modal-header">
        <h2>Recuperar senha</h2>
        <p>Envia-te um email para redefinir a senha</p>
      </div>
      <%= simple_form_for(User.new, as: :user, url: user_password_path, html: { method: :post, class: "login-modal-form" }, data: { turbo: false }) do |f| %>
        <div class="login-field">
          <label>EMAIL</label>
          <%= f.input :email, required: false, label: false, placeholder: "nome@exemplo.com",
                      input_html: { autocomplete: "email", class: "login-input" } %>
        </div>
        <%= f.button :submit, "Enviar instruções", class: "login-submit-btn" %>
      <% end %>
      <div class="login-modal-footer">
        <p>Lembrou a senha? <a href="#" class="login-create-link" data-action="click->login-modal#switchToLogin">Voltar ao login</a></p>
      </div>
    </div>

    <%# ============ PAINEL RESET PASSWORD ============ %>
    <div data-login-modal-target="panelResetPassword" hidden>
      <div class="login-modal-header">
        <h2>Nova senha</h2>
        <p>Escolhe uma nova senha para a tua conta</p>
      </div>
      <%= simple_form_for(User.new, as: :user, url: user_password_path, html: { method: :put, class: "login-modal-form" }, data: { turbo: false }) do |f| %>
        <%= f.input :reset_password_token, as: :hidden,
                    input_html: { value: params[:reset_password_token] } %>
        <div class="login-field">
          <label>NOVA SENHA</label>
          <%= f.input :password, required: false, label: false, placeholder: "••••••••",
                      input_html: { autocomplete: "new-password", class: "login-input" } %>
        </div>
        <div class="login-field">
          <label>CONFIRMAR NOVA SENHA</label>
          <%= f.input :password_confirmation, required: false, label: false, placeholder: "••••••••",
                      input_html: { autocomplete: "new-password", class: "login-input" } %>
        </div>
        <%= f.button :submit, "Redefinir senha", class: "login-submit-btn" %>
      <% end %>
      <div class="login-modal-footer">
        <p>Lembrou a senha? <a href="#" class="login-create-link" data-action="click->login-modal#switchToLogin">Voltar ao login</a></p>
      </div>
    </div>

  </div>
</div>
