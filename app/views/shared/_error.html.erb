<%# app/views/shared/_error.html.erb %>
<div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
  <div class="text-red-500 text-5xl mb-4">⚠️</div>
  <h3 class="text-lg font-semibold text-red-800 mb-2">Ops! Algo deu errado</h3>
  <p class="text-red-700"><%= message || "Não foi possível gerar as recomendações no momento." %></p>
  <p class="text-sm text-red-600 mt-4">Tente novamente mais tarde.</p>
  <% if session %>
    <a href="/" class="mt-4 inline-block bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">
      Voltar para o início
    </a>
  <% end %>
</div>
